# Dataset bruto — não versionar (121 MB+).
# Recupere com: python src/download_data.py
data/raw/

# Zips baixados do Kaggle / Releases
data/*.zip

# Banco DuckDB gerado pela carga — é artefato, reconstrua com src/load_raw.py
*.duckdb
*.duckdb.wal

# Credenciais de conexão — NUNCA versionar.
# O modelo sem senhas está em .env.example, esse sim versionado.
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# SO / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Pastas de trabalho do formato PBIP (Power BI Project).
# O `.pbi/` guarda cache de dados (`cache.abf`, ~11 MB, regenerado sozinho) e
# `localSettings.json` com CAMINHOS ABSOLUTOS da maquina. Versionar o primeiro
# repete o problema do binario que o PBIP veio resolver; versionar o segundo
# gera conflito a cada troca entre o notebook e o PC.
**/.pbi/
