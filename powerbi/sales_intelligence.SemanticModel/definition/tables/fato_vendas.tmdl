table fato_vendas
	lineageTag: 9654b62e-f100-459d-843b-95366f373359

	measure Receita = CALCULATE ( SUM ( fato_vendas[preco] ) + SUM ( fato_vendas[frete] ), dim_status_pedido[eh_venda_efetiva] = TRUE () )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 53ff27a1-7627-4d88-ae3a-46e9dd7881da

	measure 'Receita Mercadoria' = CALCULATE ( SUM ( fato_vendas[preco] ), dim_status_pedido[eh_venda_efetiva] = TRUE () )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: bc76a9c1-6429-435a-b028-79bf17583e29

	measure 'Receita Frete' = CALCULATE ( SUM ( fato_vendas[frete] ), dim_status_pedido[eh_venda_efetiva] = TRUE () )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 0539a267-b6b0-4c41-b1de-df1f7c5c2577

	measure 'Receita (com cancelados)' = SUM ( fato_vendas[preco] ) + SUM ( fato_vendas[frete] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 4c2c8064-037e-4c2d-87bf-9b75eca2fde2

	measure Pedidos = CALCULATE ( DISTINCTCOUNT ( fato_vendas[order_id] ), dim_status_pedido[eh_venda_efetiva] = TRUE () )
		formatString: #,0
		lineageTag: 8315b8e7-46de-4e7e-a72c-04038004593f

	measure 'Itens Vendidos' = CALCULATE ( COUNTROWS ( fato_vendas ), dim_status_pedido[eh_venda_efetiva] = TRUE () )
		formatString: #,0
		lineageTag: 7814e66c-a839-493c-85bc-ecc435aa6b44

	measure Clientes = CALCULATE ( DISTINCTCOUNT ( fato_vendas[sk_cliente] ), dim_status_pedido[eh_venda_efetiva] = TRUE () )
		formatString: #,0
		lineageTag: 55912b82-d66e-4b81-83f1-1d6e6ce17c03

	measure 'Ticket Médio' = DIVIDE ( [Receita], [Pedidos] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: b9cfbc5a-6485-464a-9621-183f17fba11f

	measure 'Itens Entregues' = CALCULATE ( COUNT ( fato_vendas[dias_entrega] ), dim_status_pedido[eh_entregue] = TRUE () )
		formatString: #,0
		lineageTag: 844144a7-b073-4fb0-b0f2-5ba742fbdc2c

	measure 'Prazo Médio de Entrega' = CALCULATE ( AVERAGE ( fato_vendas[dias_entrega] ), dim_status_pedido[eh_entregue] = TRUE () )
		formatString: 0.00
		lineageTag: ad269205-4a97-47f4-8273-ae5c4f91c8b4

	measure 'Itens com Atraso' = CALCULATE ( COUNTROWS ( fato_vendas ), dim_status_pedido[eh_entregue] = TRUE (), fato_vendas[dias_vs_previsto] > 0 )
		formatString: #,0
		lineageTag: 65e478b9-74e6-4a63-955f-94052ad9c26f

	measure '% Entregue com Atraso' = DIVIDE ( [Itens com Atraso], [Itens Entregues] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 89c7d128-f8e5-40bb-a6eb-c84d10207e87

	measure 'Folga Média do Prazo' = CALCULATE ( AVERAGE ( fato_vendas[dias_vs_previsto] ), dim_status_pedido[eh_entregue] = TRUE () )
		formatString: 0.00
		lineageTag: 60f36c61-f07b-4d54-bca0-b9f6c546a9eb

	measure 'Itens por Pedido' = DIVIDE ( [Itens Vendidos], [Pedidos] )
		formatString: 0.00
		lineageTag: 75fde60c-c3cb-4bcc-b870-1b875b044ee1

	measure Categorias = CALCULATE ( DISTINCTCOUNT ( dim_produto[categoria] ), fato_vendas, dim_status_pedido[eh_venda_efetiva] = TRUE () )
		formatString: #,0
		lineageTag: 38e9e37c-09d9-4424-b7e0-db825bc34f20

	measure 'Produtos Vendidos' = CALCULATE ( DISTINCTCOUNT ( fato_vendas[sk_produto] ), dim_status_pedido[eh_venda_efetiva] = TRUE () )
		formatString: #,0
		lineageTag: 6880f203-1dec-4f65-b001-e89f14adfebf

	measure 'Preço Médio Item' = DIVIDE ( [Receita Mercadoria], [Itens Vendidos] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: aaf62b05-2ff1-4c51-9b65-41298426e8b1

	measure '% Frete' = DIVIDE ( [Receita Frete], [Receita Mercadoria] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 76752d99-73b4-4cf6-af6c-f736579b3dfb

	measure '% Acumulado' = VAR ReceitaAtual = [Receita] VAR TotalGeral = CALCULATE ( [Receita], REMOVEFILTERS ( dim_produto[categoria] ) ) VAR Acumulado = CALCULATE ( [Receita], FILTER ( ALLSELECTED ( dim_produto[categoria] ), [Receita] >= ReceitaAtual ) ) RETURN DIVIDE ( Acumulado, TotalGeral )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 028b7da2-2c54-4d06-8dc3-7b0ace2cac1d

	measure 'Clientes Recorrentes' = CALCULATE ( COUNTROWS ( FILTER ( VALUES ( fato_vendas[sk_cliente] ), CALCULATE ( DISTINCTCOUNT ( fato_vendas[order_id] ) ) >= 2 ) ), dim_status_pedido[eh_venda_efetiva] = TRUE () )
		formatString: #,0
		lineageTag: a0052a4f-863a-4f4c-a894-84ce1bd9a4e3

	measure 'Taxa de Recorrência' = DIVIDE ( [Clientes Recorrentes], [Clientes] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ef9a56be-f16a-490f-9fa7-678696255e2f

	measure 'Receita por Cliente' = DIVIDE ( [Receita], [Clientes] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: c5cdab10-3884-41b7-a016-eee5b6fecbec

	measure 'Itens (com cancelados)' = COUNTROWS ( fato_vendas )
		formatString: #,0
		lineageTag: b966c828-8f8a-46c1-81a0-6eac9c74c9e4

