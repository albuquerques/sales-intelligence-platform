# Modelo de configuração da conexão com o PostgreSQL.
#
# Este arquivo É versionado — ele documenta QUAIS variáveis existem, sem
# revelar os valores. O arquivo real (.env) fica de fora do Git.
#
# Para usar:
#   1. copie este arquivo para .env
#   2. preencha PGPASSWORD com a senha definida na instalação do PostgreSQL
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env

PGHOST=localhost
PGPORT=5432
PGDATABASE=sales_intelligence
PGUSER=postgres
PGPASSWORD=troque-por-sua-senha
